# ==============================================================================
# SOC Analyst Portfolio - Secure Backend Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Session Configuration
# Generate a cryptographically random secret in production (min 32 bytes)
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_session_secret_change_in_production_9f83a04e57b98d2

# Strict Session Lifetime in Minutes (Enforced Server-Side)
SESSION_LIFETIME_MINUTES=10

# Splunk Enterprise Enclave Connection
# Authentication is performed live against Splunk's REST API endpoint (port 8089)
# NEVER commit or store Splunk passwords in this file, Git, or frontend code.
SPLUNK_HOST=127.0.0.1
SPLUNK_MGMT_PORT=8089
SPLUNK_WEB_PORT=8000
SPLUNK_VERIFY_SSL=false
SPLUNK_TIMEOUT_MS=5000

# Rate Limiting
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# ==============================================================================
# SMTP / Email Approval Configuration (Phase 2 Workflow)
# NOTE: Leave empty to disable live email dispatch until credentials are confirmed.
# The server will return HTTP 503 explaining that email service is not yet active.
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SOC Lab Access" <noreply@akash-sec.internal>
ADMIN_NOTIFY_EMAIL=akashdjadhav3730@gmail.com
APPROVAL_TOKEN_LIFETIME_MINUTES=15
